# Use your final HTTPS URL behind a tunnel or reverse proxy.
YEET_ORIGIN=https://yeet.example.com
# Published pages are served from this second hostname, which must reach the same
# Yeet port. Leave it empty only for a trial; pages then share the account origin.
YEET_CONTENT_ORIGIN=https://yeet-content.example.com
YEET_INSECURE_COOKIE=0
# Enable only when all requests reach Yeet through your trusted proxy.
YEET_TRUST_PROXY=0
